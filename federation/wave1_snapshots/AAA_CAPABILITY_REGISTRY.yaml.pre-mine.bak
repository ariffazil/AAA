# -----------------------------------------------------------------------------
# The Seven Axes of Reality Execution
# Each axis owns one or more canonical capabilities. Each capability is
# served by one or more backends. Backends are F-rated and disabled-by-default.
# -----------------------------------------------------------------------------
axes:

  # ---------- AXIS 1 — SENSE -------------------------------------------------
  sense:
    description: "Observe the current external world."
    authority_default: read_only
    canonical_capabilities:
      reality.search:
        description: "Capability-keyed web/news/image/local retrieval."
        F_rating: REVIEW
        backends:
          brave-search: { rank: 1, F_rating: REVIEW, enabled: true, transport: stdio, note: "dedup candidate", seal: sealed}
          exa: { rank: 2, F_rating: REVIEW, enabled: true, transport: stdio, note: "dedup candidate", seal: sealed}
          perplexity: { rank: 3, F_rating: REVIEW, enabled: true, transport: stdio, note: "dedup candidate", seal: sealed}
          fetch: { rank: 4, F_rating: HOLD,   enabled: true, transport: stdio, note: "duplicates forge_fetch (suppress)", seal: sealed}
          # Wave 1 (2026-08-11) — the 7 organs (QMG_E1).
          # arifOS routes its internal MCP through the canonical kernel host.
          arifos: { F_rating: REVIEW, enabled: true, seal: sealed, transport: stdio, authority_mode: read_only, note: "arifOS constitutional kernel — F1-F13 + 888_JUDGE; routes reality.search via canonical kernel" }
          minimax: { F_rating: REVIEW, enabled: true, seal: sealed, transport: stdio, authority_mode: read_only, note: "minimax-coding-plan-mcp (uvx) — web_search via MiniMax provider" }
        dedup_resolution: "collapse to top-2 by F-rating once Wave 2 unsealed"
      reality.browse:
        description: "Structured browser interaction through accessibility snapshots."
        F_rating: HOLD
        backends:
          playwright: { F_rating: HOLD, enabled: true, transport: stdio, note: "duplicates forge_browser_*; A-FORGE gate required", seal: sealed}

  # ---------- AXIS 2 — KNOW --------------------------------------------------
  know:
    description: "Retrieve authoritative documentation and operational context."
    authority_default: read_only
    canonical_capabilities:
      knowledge.docs:
        description: "Library / SDK documentation lookup with version specificity."
        F_rating: REVIEW
        backends:
          context7: { F_rating: REVIEW, enabled: true, transport: stdio, seal: sealed}
      knowledge.capability_index:
        description: "Compact map of available federation capabilities."
        F_rating: REVIEW
        backends:
          capability-index: { F_rating: REVIEW, enabled: true, transport: stdio, note: "verify not a shadow of forge_kernel", seal: sealed}
      knowledge.repo_map:
        description: "Repository topology and dependency maps."
        F_rating: REVIEW
        backends:
          repomapper: { F_rating: REVIEW, enabled: true, transport: stdio, authority_mode: read_only, note: "overlaps FORGE-repo-intelligence", seal: sealed}

  # ---------- AXIS 3 — REMEMBER ----------------------------------------------
  remember:
    description: "Recover durable experience across otherwise stateless calls."
    authority_default: read_append
    canonical_capabilities:
      memory.recall:
        description: "Persistent relationship/temporal memory."
        F_rating: SAFE
        backends:
          hindsight: { F_rating: SAFE, enabled: true, transport: http, url: http://127.0.0.1:18087/mcp, seal: sealed, source: claude+codex }
          graphiti:  { F_rating: SAFE, enabled: true, transport: http, url: http://127.0.0.1:8000/mcp,  seal: sealed, source: claude+codex }
      memory.vector:
        description: "Semantic vector storage and retrieval."
        F_rating: HOLD
        backends:
          qdrant: { F_rating: HOLD, enabled: true, transport: stdio, note: "check pgvector duplication before Wave 3", seal: sealed}

  # ---------- AXIS 4 — UNDERSTAND --------------------------------------------
  understand:
    description: "Navigate symbols, dependencies, and structured systems."
    authority_default: read_only
    canonical_capabilities:
      code.navigate:
        description: "Semantic code retrieval and editing."
        F_rating: HOLD
        backends:
          serena: { F_rating: HOLD, enabled: true, transport: stdio, note: "duplicates forge_filesystem semantics", seal: sealed}
          repomapper: { F_rating: HOLD, enabled: true, transport: stdio, authority_mode: read_write, note: "edit-capable surface; cross-axis with knowledge.repo_map (read_only)", seal: sealed}
      db.query:
        description: "Structured relational truth retrieval."
        F_rating: HOLD
        backends:
          postgres: { F_rating: HOLD, enabled: true, transport: stdio, note: "duplicates forge_postgres", seal: sealed}
          supabase: { F_rating: HOLD, enabled: true, transport: stdio, note: "wraps postgres + project-ref", seal: sealed}

  # ---------- AXIS 5 — VERIFY ------------------------------------------------
  verify:
    description: "Test claims, code, and proposed changes."
    authority_default: read_only_scanners
    canonical_capabilities:
      evidence.scan:
        description: "Static security/quality scan."
        F_rating: HOLD
        backends:
          semgrep: { F_rating: HOLD, enabled: true, transport: stdio, seal: sealed}
      evidence.browser:
        description: "Browser-level behavioural evidence capture."
        F_rating: HOLD
        backends:
          playwright: { F_rating: HOLD, enabled: true, transport: stdio, mode: verify_only, seal: sealed}
      evidence.epistemic:
        description: "Federation epistemic and contradiction checks."
        F_rating: REVIEW
        backends:
          hermes: { F_rating: REVIEW, enabled: true, transport: stdio, note: "internal — must route via arifOS, not duplicate", seal: sealed}
      evidence.reasoning:
        description: "Structured multi-step reasoning amplification."
        F_rating: HOLD
        backends:
          sequential-thinking: { F_rating: HOLD, enabled: true, transport: stdio, note: "execution amplifier — FQ risk; A-FORGE gate required", seal: sealed}

  # ---------- AXIS 6 — FORGE -------------------------------------------------
  forge:
    description: "Mutate repositories, databases, and infrastructure."
    authority_default: gated_write
    canonical_capabilities:
      forge.repository:
        description: "Repository mutation (issues, PRs, commits)."
        F_rating: HOLD
        gate: A-FORGE_lease
        backends:
          github: { F_rating: HOLD, enabled: true, transport: stdio, gate: A-FORGE_lease, note: "duplicates forge_github_*", seal: sealed}
      forge.container:
        description: "Container execution and management."
        F_rating: HOLD
        gate: A-FORGE_lease
        backends:
          docker: { F_rating: HOLD, enabled: true, transport: stdio, gate: A-FORGE_lease, seal: sealed}
      forge.database:
        description: "Database mutation — single canonical = forge_postgres."
        F_rating: HOLD
        gate: A-FORGE_lease
        backends:
          postgres: { F_rating: HOLD, enabled: true, transport: stdio, gate: A-FORGE_lease, note: "single canonical", seal: sealed}
          supabase: { F_rating: HOLD, enabled: true, transport: stdio, gate: A-FORGE_lease, note: "secondary; project-pinned", seal: sealed}
          sqlite: { F_rating: HOLD, enabled: true, transport: stdio, gate: A-FORGE_lease, note: "should be Postgres primitive, not side-channel", seal: sealed}
      forge.provider:
        description: "Third-party model provider MCP."
        F_rating: HOLD
        gate: A-FORGE_lease
        backends:
          minimax-mcp: { F_rating: HOLD, enabled: true, transport: stdio, gate: A-FORGE_lease, note: "BLOCKED — name collision with minimax on Kimi", seal: sealed}
      forge.infrastructure:
        description: "VPS / bare-metal management."
        F_rating: HOLD
        gate: A-FORGE_lease
        backends:
          hostinger-vps: { F_rating: HOLD, enabled: true, transport: stdio, gate: A-FORGE_lease, note: "A-FORGE-only — VPS ops must never bypass federation gates", seal: sealed}

  # ---------- AXIS 7 — WITNESS -----------------------------------------------
  witness:
    description: "Record outcomes, evidence, and operational health."
    authority_default: append_only
    canonical_capabilities:
      witness.append:
        description: "Immutable, append-only operational witness. Authority mode = append_only (read references, no mutation). Same backend may serve other axes under different authority modes — the capability-keyed router enforces axis at call site."
        F_rating: SAFE
        backends:
          # Primary (already canonical)
          VAULT999: { F_rating: SAFE, enabled: true,  transport: filesystem, seal: sealed, note: "primary receipt store" }
          arifFlow: { F_rating: SAFE, enabled: true,  transport: http, url: http://127.0.0.1:7073, seal: sealed, note: "FQ metabolism + receipts" }
          # Cross-axis: same backend, different authority mode
          hindsight: { F_rating: SAFE, enabled: true, transport: http, url: http://127.0.0.1:18087/mcp, authority_mode: append_only, note: "searchable operational experience", seal: sealed}
          graphiti: { F_rating: SAFE, enabled: true, transport: http, url: http://127.0.0.1:8000/mcp,  authority_mode: append_only, note: "relationships + temporal context", seal: sealed}
          github: { F_rating: SAFE, enabled: true, transport: stdio, authority_mode: read_only, note: "immutable commit/PR references; cross-axis from forge.repository", seal: sealed}
          postgres: { F_rating: SAFE, enabled: true, transport: stdio, authority_mode: append_only, note: "append-only receipt rows; cross-axis from forge.database/db.query", seal: sealed}

# -----------------------------------------------------------------------------
# Enable policy — three-wave rollout, every wave gated by F13 seal
# -----------------------------------------------------------------------------
enablement_policy:
  wave_1_safe_http:
    description: "HTTP-only, read/append, low blast. Auto-enabled AFTER F13 seal."
    list: [hindsight, graphiti]
    auto_enable: false              # always require explicit F13 seal before enabled: true
    transport_constraint: http_only
  wave_2_review:
    description: "Backend-pluggable. Require 333_propose → 555_verify → 888_judge → seal."
    list:
      - brave-search
      - exa
      - perplexity
      - context7
      - capability-index
      - repomapper
      - hermes
    auto_enable: false
    require: [333_propose, 555_verify, 888_judge, seal]
  wave_3_hold:
    description: "Execution amplifiers / duplicates. Require full pipeline + A-FORGE lease."
    list:
      - playwright
      - docker
      - semgrep
      - github
      - postgres
      - qdrant
      - supabase
      - sqlite
      - serena
      - hostinger-vps
      - fetch
      - minimax-mcp
      - sequential-thinking
    auto_enable: false
    require: [333_propose, 555_verify, 888_judge, seal, A-FORGE_lease]

# -----------------------------------------------------------------------------
# Dedup register — collapse candidate groups to one canonical capability
# -----------------------------------------------------------------------------
dedup_register:
  reality.search:
    backends: [brave-search, exa, perplexity, fetch]
    resolution: "collapse to top-2 by F-rating once Wave 2 unsealed; fetch suppressed (duplicates forge_fetch)"
  forge.repository:
    backends: [github]
    resolution: "suppress raw MCP; route via forge_github_*"
  db.query:
    backends: [postgres, supabase]
    resolution: "suppress raw MCP; route via forge_postgres"
  forge.database:
    backends: [postgres, supabase, sqlite]
    resolution: "single canonical = forge_postgres; sqlite as Postgres primitive"
  forge.provider:
    backends: [minimax-mcp]
    resolution: "BLOCKED — name collision with minimax already on Kimi Code"
  memory.recall:
    backends: [hindsight, graphiti]
    resolution: "keep both — graph (graphiti) and bank (hindsight) are orthogonal surfaces"

