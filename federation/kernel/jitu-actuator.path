[Unit]
Description=JITU out-of-band actuator trigger — fires when trip.json appears (F13 SAH 2026-10-07)
Documentation=file:/root/AAA/instructions/asi-substrate-invariants.md

[Path]
# PathChanged fires on file creation OR modification (transition), NOT on continuous existence.
# This is the right primitive for a one-shot-per-trip actuator: each sovereign trip = one fire.
# On release (trip file deleted) + re-trip, the path re-arms and fires again.
PathChanged=/root/.local/share/arifos/jitu/trip.json
Unit=jitu-actuator.service

[Install]
WantedBy=multi-user.target
