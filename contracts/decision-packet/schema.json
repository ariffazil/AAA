{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionPacket",
  "description": "Decision Packet Contract v1.0.0 — Canonical container for evidence-bearing multi-agent decisions in arifOS federation.",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "created_at_utc",
    "task",
    "execution",
    "evidence",
    "findings",
    "action",
    "integrity",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "packet_id": {
      "type": "string",
      "pattern": "^dp_[0-9]{8}_[a-f0-9]{8,}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "object",
      "required": ["task_id", "intent", "task_class", "risk_class", "requester"],
      "properties": {
        "task_id": { "type": "string" },
        "intent": { "type": "string" },
        "task_class": {
          "type": "string",
          "enum": ["data_analysis", "code_engineering", "research", "governance", "domain_cognition"]
        },
        "risk_class": {
          "type": "string",
          "enum": ["R0", "R1", "R2", "R3", "R4"]
        },
        "requester": {
          "type": "object",
          "required": ["type", "id", "authority"],
          "properties": {
            "type": { "type": "string", "enum": ["human", "agent", "system"] },
            "id": { "type": "string" },
            "authority": { "type": "string" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["orchestrator", "route", "session"],
      "properties": {
        "orchestrator": { "type": "string" },
        "route": {
          "type": "object",
          "required": ["router", "selected_agent", "selected_model", "allowed_capabilities"],
          "properties": {
            "router": { "type": "string" },
            "route_id": { "type": "string" },
            "selected_agent": { "type": "string" },
            "selected_model": { "type": "string" },
            "allowed_capabilities": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "session": {
          "type": "object",
          "required": ["session_id_hash", "authority_context", "policy_version"],
          "properties": {
            "session_id_hash": { "type": "string" },
            "authority_context": { "type": "string" },
            "policy_version": { "type": "string" }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["datasets", "sources", "tool_calls"],
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dataset_id", "manifest_hash", "classification"],
            "properties": {
              "dataset_id": { "type": "string" },
              "version": { "type": "string" },
              "manifest_hash": { "type": "string" },
              "classification": { "type": "string" }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "url", "content_hash", "retrieved_at_utc"],
            "properties": {
              "source_id": { "type": "string" },
              "url": { "type": "string" },
              "content_hash": { "type": "string" },
              "retrieved_at_utc": { "type": "string" }
            }
          }
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["server_id", "tool_name", "query_hash", "result_hash", "elapsed_ms", "status"],
            "properties": {
              "server_id": { "type": "string" },
              "server_code_hash": { "type": "string" },
              "tool_name": { "type": "string" },
              "input_hash": { "type": "string" },
              "query_hash": { "type": "string" },
              "result_hash": { "type": "string" },
              "elapsed_ms": { "type": "number" },
              "rows_returned": { "type": "integer" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "required": ["observations", "interpretations"],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "confidence", "evidence_refs"],
            "properties": {
              "statement": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "interpretations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "confidence", "status", "assumptions", "evidence_refs"],
            "properties": {
              "statement": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "status": { "type": "string", "enum": ["hypothesis", "preliminary", "falsified", "confirmed"] },
              "assumptions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["proposed", "human_approval"],
      "properties": {
        "proposed": { "type": "boolean" },
        "action_class": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "rollback_ref": { "type": ["string", "null"] },
        "human_approval": {
          "type": "object",
          "required": ["required", "state"],
          "properties": {
            "required": { "type": "boolean" },
            "state": { "type": "string", "enum": ["not_required", "pending_888_hold", "granted", "rejected"] },
            "approver_id": { "type": "string" },
            "granted_at_utc": { "type": "string" }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "canonicalization",
        "hash_algorithm",
        "sequence_no",
        "packet_hash",
        "previous_ledger_hash",
        "ledger_id",
        "emitted_by",
        "request_nonce",
        "correlation_id",
        "sealed_at_utc"
      ],
      "properties": {
        "parent_packets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "canonicalization": { "type": "string", "enum": ["RFC8785-JCS"] },
        "hash_algorithm": { "type": "string", "enum": ["SHA-256"] },
        "sequence_no": { "type": "integer", "minimum": 1 },
        "packet_hash": { "type": "string" },
        "previous_ledger_hash": { "type": "string" },
        "ledger_id": { "type": "string", "enum": ["aaa-decision-ledger-main", "aaa-decision-ledger-canary"] },
        "emitted_by": {
          "type": "object",
          "required": ["service_id", "code_hash"],
          "properties": {
            "service_id": { "type": "string" },
            "code_hash": { "type": "string" }
          }
        },
        "request_nonce": { "type": "string" },
        "correlation_id": { "type": "string" },
        "sealed_at_utc": { "type": "string" },
        "artifact_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "retention_class": { "type": "string" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["status", "limitations"],
      "properties": {
        "status": { "type": "string", "enum": ["completed", "held", "failed", "aborted"] },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next_review_at_utc": { "type": ["string", "null"] }
      }
    }
  },
  "additionalProperties": false
}
