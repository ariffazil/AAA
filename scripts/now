#!/usr/bin/env python3
"""now — same board as MOTD. --json = machine-readable lamps."""
import json
import os
import runpy
import sys

if "--json" in sys.argv:
    ns = runpy.run_path("/usr/local/bin/arifos-board", run_name="arifos_board")
    kvm, role = ns["_finger"]()
    organs = {name: ns["_lamp"](ns["COURT"], port, path) for name, port, path in ns["COURT_ORGANS"]}
    print(json.dumps({"kvm": kvm, "role": role, "organs": organs, "lamp_rule": "HTTP body beats TCP"}, indent=2))
else:
    os.execv("/usr/local/bin/arifos-board", ["arifos-board"])
