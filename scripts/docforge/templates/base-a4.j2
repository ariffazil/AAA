<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{TITLE}}</title>
<style>
/* ── STRUCTURE (this file) ─────────────────────────────────────────────────
   Page geometry, margin boxes, and the layout skeleton. Colour and type live
   in the theme, so one template serves every theme. */
@page {
  size: A4;
  margin: 16mm 14mm 15mm 14mm;
  @bottom-left  { content: "{{TITLE}}"; font-size: 7pt; color: #7a8590; }
  @bottom-right { content: "{{EDITION}} · " counter(page) " / " counter(pages);
                  font-size: 7pt; color: #7a8590; }
}
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { margin: 0; }
h1 { font-size: 19pt; margin: 0 0 3mm 0; line-height: 1.15; }
h2 { font-size: 12pt; margin: 7mm 0 2mm 0; padding-bottom: 1.4mm;
     border-bottom: 1px solid var(--rule); page-break-after: avoid; }
h3 { font-size: 10pt; margin: 4mm 0 1.5mm 0; page-break-after: avoid; }
p, li { font-size: 9.2pt; line-height: 1.5; margin: 0 0 2.2mm 0; }
ul, ol { margin: 0 0 2.5mm 5mm; padding: 0; }
table { width: 100%; border-collapse: collapse; margin: 3mm 0 4mm 0; font-size: 8.4pt; }
th { text-align: left; padding: 1.6mm 2mm; font-size: 7.8pt; font-weight: 700;
     border-bottom: 1.6px solid var(--rule-strong); }
td { padding: 1.5mm 2mm; border-bottom: 1px solid var(--rule-faint); vertical-align: top; }
tbody tr:nth-child(even) td { background: var(--zebra); }
h2, h3, tr { page-break-inside: avoid; }
.cover { page-break-after: always; }
.cover-rule { height: 3px; width: 34mm; background: var(--accent); margin: 0 0 6mm 0; }
.subtitle { font-size: 11pt; color: var(--muted); margin: 0 0 14mm 0; }
.meta { font-size: 8.2pt; color: var(--muted); line-height: 1.7; }
.stats { display: flex; gap: 3mm; margin: 6mm 0; }
.stat { flex: 1; border-top: 3px solid var(--accent); padding: 2mm 2.2mm;
        background: var(--panel); }
.stat .n { font-size: 13pt; font-weight: 700; color: var(--accent-ink); }
.stat .l { font-size: 7.4pt; color: var(--muted); line-height: 1.35; }
.box { padding: 2.6mm 3mm; margin: 3mm 0; border-left: 4px solid var(--accent); }
.box.key    { background: var(--panel); }
.box.warn   { background: var(--warn-bg); border-left-color: var(--warn); }
.box.open   { background: var(--open-bg); border-left-color: var(--open); }
.box.claim  { background: var(--claim-bg); border-left-color: var(--claim); }
.kv { font-family: var(--mono); font-size: 7.2pt; background: var(--panel);
      padding: 2.6mm; line-height: 1.6; word-break: break-all;
      border: 1px solid var(--rule-faint); border-left: 3px solid var(--accent); }
.tag { display: inline-block; font-size: 6.8pt; font-weight: 700; padding: 0.3mm 1.4mm;
       border-radius: 2px; border: 1px solid; }
.small { font-size: 7.8pt; color: var(--muted); }
.nobreak { page-break-inside: avoid; }

/* ── THEME ──────────────────────────────────────────────────────────────── */
{{THEME_CSS}}
</style>
</head>
<body>

<section class="cover">
  <div class="cover-rule"></div>
  <h1>{{TITLE}}</h1>
  <div class="subtitle">{{SUBTITLE}}</div>
  <div class="meta">
    Edition <strong>{{EDITION}}</strong><br>
    {{EDITION_DATE}}<br>
    Built by the docforge lane · integrity seal applied
  </div>
  <div class="stats">
    <div class="stat"><div class="n">{{STAT_NEW}}</div><div class="l">New items</div></div>
    <div class="stat"><div class="n">{{STAT_OPEN}}</div><div class="l">Carrying over</div></div>
    <div class="stat"><div class="n">{{STAT_CONTESTED}}</div><div class="l">Contested</div></div>
    <div class="stat"><div class="n">{{STAT_SETTLED}}</div><div class="l">Settled / terminal</div></div>
  </div>
  <div class="kv" style="margin-top:8mm">
    content_sha256 &nbsp;{{CONTENT_HASH}}<br>
    artifact_sha256 {{ARTIFACT_HASH}}<br>
    signature &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;not_signed (hashes only;
    authorship is not proven by a hash)
  </div>
  <div class="small" style="margin-top:3mm">
    The content hash above covers the canonical source of this document and was
    computed before it was injected, so it is checkable from the page. The
    artifact hash covers the rendered file's bytes and therefore cannot appear
    inside it — it ships in the sidecar, in <code>sha256sum -c</code> format.
    Neither hash says anything about whether the contents are true.
  </div>
</section>

{{BODY}}

</body>
</html>
