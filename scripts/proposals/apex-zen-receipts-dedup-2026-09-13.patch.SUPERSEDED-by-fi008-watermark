+def _receipt_id(record: dict, metric: str, value) -> str:
+    """Stable dedup key: the same telemetry row + metric never emits twice."""
+    basis = f"{record.get('source', '')}|{record.get('timestamp', '')}|{metric}|{value}"
+    return hashlib.sha256(basis.encode()).hexdigest()[:16]
