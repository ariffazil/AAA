#!/usr/bin/env python3
"""
render-opencode-config — Project OpenCode config from federation-models.json SOT.

SOT-first, idempotent, drift=0 contract:
  * Loads /root/.config/federation-models.json (canonical SOT).
  * Loads /root/.config/opencode/opencode.json (existing config — preserved verbatim
    for keys outside the resolved surface: provider, mcp, references, permission,
    compaction, default_agent, lsp, formatter, autoupdate, instructions, $schema).
  * For each existing agent, resolves model from SOT primary_model with fallback_chain
    walk against live provider aliveness (token_bank.db balance/confidence + SOT
    provider status). Never invents new agents; never removes existing ones.
  * enabled_providers = existing UNION providers referenced by resolved models.
  * top-level model/small_model sync to 333-AGI / dispatch agents if present.
  * NO hardcoded provider bypass (DeepSeek is not special-cased — dead = dead).
  * Idempotency: SHA before/after; if unchanged → no-op (no backup, no write).

Usage:
  render-opencode-config              # dry-run, print resolution table
  render-opencode-config --diff      # show structural diff vs current
  render-opencode-config --apply     # write atomically (backup if changed)

Forged: 2026-08-19 by 333-AGI Δ MIND (repair of composite defect).
"""

import json, sys, hashlib, subprocess, tempfile, os
from pathlib import Path
from datetime import datetime, timezone

sys.path.insert(0, '/root/AAA/src')
from resolvers.model_resolver import _load, _agents_map, _providers_map  # noqa: E402

CANONICAL = Path("/root/.config/federation-models.json")
OP_ENCODE_CONFIG = Path("/root/.config/opencode/opencode.json")
TOKEN_BANK_DB = Path("/root/.local/share/arifos/token_bank.db")

PRESERVE_KEYS = (
    "provider", "mcp", "references", "permission", "compaction",
    "default_agent", "lsp", "formatter", "autoupdate", "instructions", "$schema",
)
# agents whose resolved model drives top-level slots
TOP_MODEL_AGENT = "333-AGI"
SMALL_MODEL_AGENT = "dispatch"


# ── Live provider aliveness (token_bank.db + SOT status override) ───────────
def _load_alive_providers() -> dict:
    """Return {provider_id: bool}. True = alive. Combines:
       - token_bank.db: dead if balance_usd < 0 OR confidence_score == 0.0
       - SOT providers[].status == 'dead' override
       - ollama: always alive (local)
    """
    alive = {"ollama": True}
    # SOT status field
    try:
        sot = json.loads(CANONICAL.read_text())
        provs = sot.get("providers", [])
        if isinstance(provs, list):
            for p in provs:
                pid = p.get("provider_id") or p.get("id") or p.get("name")
                if pid and p.get("status", "").lower() == "dead":
                    alive[pid] = False
    except Exception:
        pass
    # token_bank.db
    try:
        import sqlite3
        conn = sqlite3.connect(str(TOKEN_BANK_DB))
        conn.row_factory = sqlite3.Row
        rows = conn.execute(
            "SELECT provider_name, balance_usd, confidence_score FROM providers"
        ).fetchall()
        conn.close()
        for r in rows:
            pid = r["provider_name"]
            bal = float(r["balance_usd"] or 0)
            conf = float(r["confidence_score"] or 0)
            db_dead = (bal < 0) or (conf == 0.0)
            if pid in alive and alive[pid] is False:
                continue  # SOT override wins
            alive[pid] = not db_dead
    except Exception as e:
        # If we can't read token_bank, log to stderr but don't crash; fall back to SOT-only
        sys.stderr.write(f"⚠️  token_bank read failed: {e}\n")
    return alive


# ── Model resolver for one SOT agent entry ───────────────────────────────────
def _resolve_agent_model(agent_entry: dict, alive: dict) -> str | None:
    """Walk primary → fallback_chain; return first model whose provider is alive.
       None if nothing alive in chain.
    """
    chain = [agent_entry.get("primary_model")] + list(agent_entry.get("fallback_chain", []))
    seen = set()
    for raw in chain:
        if not raw or raw in seen:
            continue
        seen.add(raw)
        prov = raw.split("/", 1)[0] if "/" in raw else ""
        if not prov:
            continue
        if alive.get(prov, True):  # default True if unknown
            return raw
    return None


# ── Main: idempotent SOT-driven resolution ──────────────────────────────────
def generate_config() -> tuple[dict, list[dict]]:
    sot = _load()
    agents_map = _agents_map(sot)
    alive = _load_alive_providers()
    dead = sorted([p for p, a in alive.items() if a is False])

    # Load existing config (the contract — preserve everything outside resolved surface)
    existing = {}
    if OP_ENCODE_CONFIG.exists():
        existing = json.loads(OP_ENCODE_CONFIG.read_text())

    new_agents = {}
    resolutions = []  # for logging
    for agent_id, agent_def in (existing.get("agent") or {}).items():
        old_model = agent_def.get("model", "")
        sot_entry = agents_map.get(agent_id)
        if sot_entry:
            new_model = _resolve_agent_model(sot_entry, alive)
            if new_model is None:
                # No alive provider in chain → keep existing model but flag
                resolutions.append({
                    "agent_id": agent_id,
                    "old_model": old_model,
                    "new_model": None,
                    "action": "keep_existing_NO_ALIVE_IN_SOT_CHAIN",
                })
                continue
            if new_model != old_model:
                new_agents[agent_id] = dict(agent_def)
                new_agents[agent_id]["model"] = new_model
                resolutions.append({
                    "agent_id": agent_id,
                    "old_model": old_model,
                    "new_model": new_model,
                    "action": "updated",
                })
            else:
                new_agents[agent_id] = agent_def
                resolutions.append({
                    "agent_id": agent_id,
                    "old_model": old_model,
                    "new_model": old_model,
                    "action": "no_change",
                })
        else:
            # Custom agent not in SOT — preserve unless its current provider is dead
            prov = old_model.split("/", 1)[0] if "/" in old_model else ""
            if prov and alive.get(prov, True) is False:
                new_agents[agent_id] = dict(agent_def)
                new_agents[agent_id]["model"] = "ollama/qwen2.5-coder:3b"
                resolutions.append({
                    "agent_id": agent_id,
                    "old_model": old_model,
                    "new_model": "ollama/qwen2.5-coder:3b",
                    "action": "custom_dead_provider_fallback",
                })
            else:
                new_agents[agent_id] = agent_def
                resolutions.append({
                    "agent_id": agent_id,
                    "old_model": old_model,
                    "new_model": old_model,
                    "action": "preserved_custom",
                })

    # Build new config — copy existing, overlay resolved surface
    config = dict(existing)
    config["agent"] = new_agents
    # enabled_providers: existing UNION providers referenced by resolved models
    referenced = set()
    for a in new_agents.values():
        m = a.get("model", "")
        if "/" in m:
            referenced.add(m.split("/", 1)[0])
    existing_enabled = set(existing.get("enabled_providers") or [])
    # Never remove: keep all existing enabled + add missing referenced
    new_enabled = sorted(existing_enabled | referenced | {"flame"})
    config["enabled_providers"] = new_enabled
    # top-level model / small_model sync
    if TOP_MODEL_AGENT in new_agents:
        config["model"] = new_agents[TOP_MODEL_AGENT]["model"]
    if SMALL_MODEL_AGENT in new_agents:
        config["small_model"] = new_agents[SMALL_MODEL_AGENT]["model"]
    # Provenance stamp intentionally NOT written into the config — OpenCode's schema
    # is strict (unknown top-level keys fail with "Configuration is invalid"). Provenance
    # already lives in /root/.config/opencode/opencode.meta.json. For apply-mode logging,
    # see the print() below in main().
    return config, resolutions, dead


def main():
    args = sys.argv[1:]
    apply_mode = "--apply" in args
    diff_mode = "--diff" in args

    config, resolutions, dead = generate_config()

    if diff_mode:
        with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False) as tmp:
            json.dump(config, tmp, indent=2, ensure_ascii=False)
            tmp_path = tmp.name
        try:
            subprocess.run(["diff", "-u", str(OP_ENCODE_CONFIG), tmp_path])
        finally:
            os.unlink(tmp_path)
        return

    if apply_mode:
        # Idempotency: full-config hash. The _generated stamp was removed (see comment
        # in generate_config) so a stable hash now hashes the full config.
        def stable_hash(cfg: dict) -> str:
            return hashlib.sha256(
                json.dumps(cfg, indent=2, ensure_ascii=False, sort_keys=True).encode()
            ).hexdigest()
        old_bytes = OP_ENCODE_CONFIG.read_bytes() if OP_ENCODE_CONFIG.exists() else b""
        old_obj = json.loads(old_bytes) if old_bytes else {}
        new_hash = stable_hash(config)
        old_hash = stable_hash(old_obj) if old_obj else ""
        if new_hash == old_hash:
            print(f"✅ No drift (stable sha256={new_hash[:12]}). Skipped write — idempotent.")
        else:
            if old_bytes:
                bak = Path(
                    f"/root/.config/backups/opencode-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S')}.json"
                )
                bak.write_bytes(old_bytes)
                print(f"   backup -> {bak}")
            OP_ENCODE_CONFIG.write_bytes(
                json.dumps(config, indent=2, ensure_ascii=False, sort_keys=False).encode()
            )
            print(f"✅ Rendered -> {OP_ENCODE_CONFIG} (stable sha256: {old_hash[:12]} → {new_hash[:12]})")
    else:
        # Dry-run: print resolution table
        print("=== Resolution table ===")
        for r in resolutions:
            print(f"  {r['agent_id']:30s} {r['action']:35s} {r['old_model']} → {r['new_model']}")
        print(f"\n=== Dead providers ({len(dead)}) ===")
        for p in dead:
            print(f"  {p}")

    if dead:
        sys.stderr.write(f"\n⚠️  Dead providers ({len(dead)}): {', '.join(dead)}\n")


if __name__ == "__main__":
    main()
