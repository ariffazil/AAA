        "deploy",
        "merge_protected_branch",
        "push_protected_branch",
        "cloud_control",
        "database_write",
        "external_message"
      ]
    },

    "admission": {
      "state": "NOT_ADMITTED",
      "mode": "read_only_registry_visibility",
      "must_not_grant": [
        "production_authority",
        "real_secret_access",
        "kernel_verdict_authority",
        "deployment_authority",
        "automatic_promotion"
      ]
    },

    "qdf": "888_HOLD: Lab evidence valid for offline governance logic only. Runtime and production authority remain unadmitted."
  },

  "warga_collective": {
    "enabled": true,
    "federation_class": "WARGA_AAA_CODING_CELL",
    "collective_id": "FI-003-QWEN-COLLECTIVE",
    "protocol": "MUSYAWARAH_GOTONG_ROYONG_V1",
    "authority_ceiling": "PROPOSE_AND_VERIFY",

    "roles": [
      {
        "id": "architect",
        "purpose": "Frame problem, invariants, options, acceptance criteria",
        "may": ["repo.read", "evidence.read", "plan.draft"],
        "must_not": ["patch.local", "tests.certify", "remote.write"]
      },
      {
        "id": "scout",
        "purpose": "Repository, dependency, runtime, test, and receipt reconnaissance",
        "may": ["repo.read", "evidence.read", "trace.read"],
        "must_not": ["patch.local", "policy.change", "remote.write"]
      },
      {
        "id": "forge",
        "purpose": "Implement minimal scoped local change",
        "may": ["worktree.write", "patch.local", "named_ci.request"],
        "must_not": ["merge", "push", "deploy", "self_verify", "policy.change"]
      },
      {
        "id": "refractor",
        "purpose": "Assess complexity, coupling, interface drift, and simplification",
        "may": ["repo.read", "diff.review", "review.report"],
        "must_not": ["scope.expand", "policy.change", "remote.write"]
      },
      {
        "id": "integrator",
        "purpose": "Check cross-module compatibility and assemble reviewed patch set",
        "may": ["repo.read", "diff.review", "candidate.bundle"],
        "must_not": ["erase_dissent", "merge", "deploy", "self_verify"]
      },
      {
        "id": "verifier",
        "purpose": "Run baseline/candidate comparison and classify results",
        "may": ["named_ci.request", "test.report", "evidence.report"],
        "must_not": ["product_code.write", "test_weakening", "merge"]
      },
      {
        "id": "red_team",
        "purpose": "Find counterexamples, bypasses, authority expansion, regressions",
        "may": ["repo.read", "adversarial_test.request", "dissent.record"],
        "must_not": ["indefinite_block_without_evidence", "product_code.write"]
      },
      {
        "id": "scribe",
        "purpose": "Produce musyawarah log, evidence packet, rollback and handoff",
        "may": ["receipt.draft", "artifact.append", "evidence.report"],
        "must_not": ["evidence.alter", "verdict.issue", "remote.write"]
      }
    ],

    "separation_rules": [
      "forge_cannot_be_sole_verifier",
      "verifier_cannot_modify_product_code_under_test",
      "integrator_cannot_remove_unresolved_dissent",
      "scribe_cannot_issue_verdict",
      "child_authority_must_be_subset_of_parent_task",
      "parallel_agents_must_have_explicit_file_or_artifact_ownership"
    ],

    "delegation": {
      "max_depth": 2,
      "task_lineage_required": true,
      "capability_monotonicity": "child_authority_subset_of_parent",
      "default_child_status": "888_HOLD_UNTIL_TASK_BOUND"
    },

    "complexity_gate": {
      "tiny_fix": ["scout", "forge", "verifier", "scribe"],
      "normal_feature": ["architect", "scout", "forge", "verifier", "red_team", "scribe"],
      "cross_module": ["architect", "scout", "forge", "refractor", "integrator", "verifier", "red_team", "scribe"],
      "authority_security_change": ["architect", "scout", "red_team", "verifier", "scribe"],
      "remote_impact": ["evidence_only_then_888_HOLD"]
    }
  }
}
