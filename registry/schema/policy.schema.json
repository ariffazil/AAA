{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aaa/registry/policy@1",
  "title": "Policy — how registry facts may be used. Registry stores facts; policy governs use",
  "type": "object",
  "required": ["schema_version", "policy_id", "applies_to", "authority", "rationale", "last_reviewed_at", "falsifier"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "applies_to": {"type": "array", "minItems": 1, "items": {"enum": ["releases", "routes", "aliases", "probes", "evaluations", "assignments", "incidents", "organizations", "families", "offerings"]}},
    "eligible_when": {"type": "array", "items": {"type": "string"}},
    "forbidden_when": {"type": "array", "items": {"type": "string"}},
    "rule": {"type": ["string", "null"]},
    "collapses_when": {"type": "array", "items": {"type": "string"}},
    "verdict_rules": {"type": "array", "items": {"type": "string"}},
    "http200_is_not": {"type": ["string", "null"]},
    "current_federation_reading": {"type": ["string", "null"]},
    "authority": {"type": "string", "minLength": 3},
    "rationale": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "last_reviewed_at": {"type": "string", "format": "date"},
    "falsifier": {"type": "string", "minLength": 8}
  }
}
