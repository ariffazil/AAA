{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aaa/registry/organization@1",
  "title": "Organization — company / lab / platform in the AI model supply chain",
  "type": "object",
  "required": ["schema_version", "organization_id", "canonical_name", "brands", "organization_types", "official_sources", "evidence_status", "last_reviewed_at", "falsifier"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 1},
    "organization_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "canonical_name": {"type": "string", "minLength": 1},
    "brands": {"type": "array", "items": {"type": "string"}},
    "organization_types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["model_developer", "publisher", "weight_distributor", "API_provider", "inference_host", "router_operator", "research_lab", "commercial_platform"]}
    },
    "jurisdiction": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "value": {"type": "string"},
        "evidence_status": {"enum": ["verified", "witnessed", "unverified", "UNKNOWN"]}
      },
      "required": ["value", "evidence_status"]
    },
    "services": {"type": "array", "items": {"type": "string"}},
    "official_sources": {"type": "array", "items": {"type": "string"}},
    "data_governance": {"type": "object"},
    "operational": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_status": {"enum": ["verified", "witnessed", "unverified", "external_claim", "UNKNOWN"]},
    "last_reviewed_at": {"type": "string", "format": "date"},
    "falsifier": {"type": "string", "minLength": 8}
  }
}
