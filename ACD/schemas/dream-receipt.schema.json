{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acd.dream-receipt.v1",
  "title": "ACD Dream Receipt",
  "description": "Minimum fields for a dream cycle receipt",
  "type": "object",
  "required": ["receipt_id", "cycle_id", "core_version", "request_id", "started_at", "completed_at", "runtime_status", "shadow", "contract_version", "ontology", "constitutional_verdict"],
  "properties": {
    "receipt_id": { "type": "string", "format": "uuid" },
    "cycle_id": { "type": "string", "format": "uuid" },
    "request_id": { "type": "string", "format": "uuid" },
    "core_version": { "type": "string" },
    "adapter_id": { "type": "string" },
    "requesting_agent": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "runtime_status": { "type": "string", "enum": ["COMPLETED", "PARTIAL", "FAILED", "BLOCKED", "HELD"] },
    "shadow": { "type": "boolean" },
    "input_evidence": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "model_witness": { "type": "object" },
    "possibility_branches": { "type": "integer", "minimum": 0 },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "dissent": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "object" },
    "compression_witness": { "type": "object" },
    "promotion_status": { "type": "string", "enum": ["NONE", "PENDING", "PETITIONED", "REJECTED"], "default": "NONE" },
    "external_actions_attempted": { "type": "integer", "default": 0 },
    "external_actions_executed": { "type": "integer", "default": 0 },
    "errors": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "constitutional_verdict": { "type": "string", "enum": ["PASS", "HOLD", "BLOCKED", "VOID"] },
    "ontology": { "type": "string", "enum": ["OBSERVED", "INFERRED", "SIMULATED", "NORMATIVE", "UNKNOWN"], "default": "SIMULATED" },
    "content_hash": { "type": "string" },
    "contract_version": { "type": "string", "const": "acd.dream.v1" }
  }
}
