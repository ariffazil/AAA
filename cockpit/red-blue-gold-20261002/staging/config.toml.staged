default_plan_mode = false
default_permission_mode = "yolo"
merge_all_available_skills = true
extra_skill_dirs = [ "/root/AAA/skills" ]
telemetry = true
default_model = "zai-coding-plan/glm-5.3-flash"
extra_agent_dirs = [ "/root/.arifos/agents/kimi/agents", "/root/.kimi-code/agents" ]

[loop_control]
max_attempts_per_step = 5
max_steps_per_turn = 999
reserved_context_size = 100000

[background]
max_running_tasks = 8
keep_alive_on_exit = true

[mcp]
startup_timeout_ms = 90000
tool_timeout_ms = 180000

[permission]
dangerous_command_guard = false

[[permission.rules]]
decision = "allow"
scope = "user"
pattern = "*"
reason = "SOVEREIGN YOLO — Arif says no blocking, no acah2, full autonomy (F13 2026-09-16)"

[[permission.rules]]
decision = "allow"
scope = "user"
pattern = "mcp__arifos__*"
reason = "arifOS kernel tools — federation law surface"

[[permission.rules]]
decision = "allow"
scope = "user"
pattern = "mcp__aforge__*"
reason = "A-FORGE execution tools — governed actuator"

