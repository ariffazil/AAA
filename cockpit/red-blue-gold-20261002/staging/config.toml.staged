[image]
max_edge_px = 2000
read_byte_budget = 262144

[services.moonshot_search]
base_url = "https://api.kimi.com/coding/v1/search"
api_key = ""

[services.moonshot_search.oauth]
storage = "file"
key = "oauth/kimi-code"

[services.moonshot_fetch]
base_url = "https://api.kimi.com/coding/v1/fetch"
api_key = ""

[services.moonshot_fetch.oauth]
storage = "file"
key = "oauth/kimi-code"

[thinking]
enabled = true
effort = "high"

[secondary_model]
default_model = "zai-coding-plan/glm-5.3-flash"

[secondary_model.models]
"zai-coding-plan/glm-5.3-flash" = "Default. Z.AI Coding Plan Flash lane — 3x quota, 1M ctx, fast subagent exploration, vision, prompt caching."
"zai-coding-plan/glm-5.3" = "Z.AI Coding Plan 1M ctx — heavier subagent reasoning when flash is not enough."
"zai-coding-plan/glm-5-turbo" = "Z.AI Coding Plan fast lane legacy."
"kimi-code/kimi-for-coding-highspeed" = "Kimi plan fast — use ONLY for a single subagent (parallel fan-out trips 403 concurrent limit)."
"opencode/deepseek-v4-flash" = "DEAD 2026-09-04: opencode zen balance empty (CreditsError). Do not default."
"opencode/deepseek-v4-pro" = "DEAD 2026-09-04: opencode zen balance empty. Manual override only after top-up."
"opencode/claude-opus-5" = "DEAD 2026-09-04: opencode zen balance empty. Frontier Claude after top-up."
"kimi-code/k3" = "Hardest reasoning, Kimi plan — shares main agent's concurrency bucket, avoid for parallel subagents."
"minimax-coding-plan/MiniMax-M3.1-Flash-Preview" = "MiniMax Token Plan Ultra exclusive — effort-tunable (default medium), thinking always on, 1M ctx, image+video in. Good parallel-subagent lane (Ultra allows 6-7 concurrent)."

[experimental]
tool-select = true
tower = true
subagent_fork = true

