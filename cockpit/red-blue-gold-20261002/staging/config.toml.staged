[[hooks]]
event = "PreToolUse"
matcher = "Bash|Shell|Write|WriteFile|Edit|StrReplace|StrReplaceFile|mcp__.*"
command = "/root/.arifos/agents/kimi/hooks/aaa-witness-pre.sh"
timeout = 12

[[hooks]]
event = "PostToolUse"
matcher = "Bash|Shell|Write|WriteFile|Edit|StrReplace|StrReplaceFile"
command = "/root/.arifos/agents/kimi/hooks/aaa-witness-post.sh"
timeout = 20

[[hooks]]
event = "PostToolUseFailure"
matcher = "Bash|Shell|Write|WriteFile|Edit|StrReplace|StrReplaceFile"
command = "/root/.arifos/agents/kimi/hooks/aaa-witness-post.sh"
timeout = 15

[[hooks]]
event = "Stop"
matcher = ""
command = "/root/.arifos/agents/kimi/hooks/aaa-session-end.sh"
timeout = 25

[[hooks]]
event = "Stop"
matcher = ""
command = "/root/.arifos/agents/kimi/hooks/aaa-completion-check.sh"
timeout = 12

[[hooks]]
event = "SessionStart"
matcher = "startup|resume"
command = "/root/.arifos/agents/kimi/hooks/aaa-session-start.sh"
timeout = 5

[[hooks]]
event = "SessionStart"
matcher = "startup|resume"
command = "/root/.arifos/agents/kimi/hooks/aaa-mcp-boot-readiness.sh"
timeout = 95

[[hooks]]
event = "SessionEnd"
matcher = "exit"
command = "/root/.arifos/agents/kimi/hooks/aaa-session-close.sh"
timeout = 5

[[hooks]]
event = "SubagentStop"
matcher = ""
command = "/root/.arifos/agents/kimi/hooks/aaa-subagent-stop.sh"
timeout = 5

[[hooks]]
event = "UserPromptSubmit"
matcher = ""
command = "/root/.arifos/agents/kimi/hooks/aaa-prompt-enrich.sh"
timeout = 3

[[hooks]]
event = "Notification"
matcher = "permission_prompt|warning|error|task\\.completed"
command = "/root/.arifos/agents/kimi/hooks/aaa-notify.sh"
timeout = 5

[[hooks]]
event = "PreCompact"
matcher = "manual|auto"
command = "/root/.arifos/agents/kimi/hooks/aaa-session-close.sh"
timeout = 3

[[hooks]]
event = "TurnStarted"
matcher = ""
command = "/root/.arifos/agents/kimi/hooks/aaa-turn-classify.sh"
timeout = 5

[[hooks]]
event = "UserPromptQueued"
matcher = ""
command = "/root/.arifos/agents/kimi/hooks/aaa-danger-warn.sh"
timeout = 5

[[hooks]]
event = "PostToolUse"
matcher = "^Skill$"
command = "/root/.arifos/agents/kimi/hooks/skill-selection-witness.sh"
timeout = 8

[[hooks]]
event = "SessionEnd"
matcher = "exit"
command = "python3 /root/.kimi-code/hooks/session_end_state.py"
timeout = 10

[[hooks]]
event = "UserPromptSubmit"
matcher = ""
command = "python3 /root/.kimi-code/hooks/user_prompt_submit_digest.py"
timeout = 5

[[hooks]]
event = "PostToolUse"
matcher = ".*"
command = "python3 /root/.kimi-code/hooks/post_tool_use_track.py"
timeout = 5

[[hooks]]
event = "PostToolUse"
matcher = "Bash|Shell|Write|WriteFile|Edit|StrReplace|StrReplaceFile|mcp__.*"
command = "python3 /root/.arifos/agents/shared/f2-receipt-citation.py"
timeout = 5


[[hooks]]
event = "UserPromptSubmit"
matcher = ""
command = "python3 /root/.kimi-code/hooks/q_collapse_anchor.py"
timeout = 5
