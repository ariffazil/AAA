  "rules": [
    {
      "rule_id": "APEX_MATH_HANDOFF_VALID",
      "rule_canon_ref": "§5.1",
      "rule_text": "handoff_valid(s, r, m) ⟺ (m ⊆ s.competency) ∧ (m ⊆ r.competency) ∧ ¬UNKNOWN_LAYER(m)",
      "severity": "MUST",
      "inputs": {
        "sender": {"type": "agent_id", "required": true, "enum": "AGENT_SIGNATURES.keys()"},
        "receiver": {"type": "agent_id", "required": true, "enum": "AGENT_SIGNATURES.keys()"},
        "asserted_math": {"type": "set<layer>", "required": true, "element_enum": "all_layers"}
      },
      "outputs": {
        "valid": {"type": "boolean"},
        "reason": {"type": "string", "must_match_if_invalid": "^MATH_HANDOFF_VIOLATION:"}
      },
      "on_violation": {
        "action": "MATH_HANDOFF_VIOLATION",
        "routes_to": "musyawarah_or_HOLD_888",
        "log_to_vaULT999": true
      }
    },

    {
      "rule_id": "APEX_MATH_SEAL_AUTHORITY",
      "rule_canon_ref": "§5.2",
      "rule_text": "may_seal(a, c) ⟺ F1_F13_pass(a, c) ∧ a.competency ⊇ math(c) ∧ W³(c) ≥ 0.85",
      "severity": "MUST",
      "inputs": {
        "agent": {"type": "agent_id", "required": true},
        "claim_layers": {"type": "set<layer>", "required": true, "element_enum": "all_layers"},
        "floor_pass": {"type": "boolean", "default": true, "checked_by": "arif_judge"},
        "w3": {"type": "float", "min": 0.0, "max": 1.0, "default": 1.0, "checked_by": "frame"}
      },
      "outputs": {
        "may_seal": {"type": "boolean"},
        "reason": {"type": "string"}
      },
      "on_violation": {
        "action": "SEAL_DENIED",
        "scope": "in_scope_only",
        "route_to": "555_asi_audit"
      }
    },

    {
      "rule_id": "APEX_MATH_SOVEREIGN_EXEMPTION",
      "rule_canon_ref": "§5 + §6 (ASI substrate)",
      "rule_text": "i-ARIF is exempted from competency checks (sovereign decides which math for which loop); W³ and F1-F13 still bind.",
      "severity": "EXCEPTION",
      "applies_to": ["i-ARIF"],
      "rationale": "i-ARIF is the meta-decision-maker about which math matters. Competency is therefore trivially complete (ALL_LAYERS)."
    }
  ],

  "violation_taxonomy": {
    "MATH_HANDOFF_VIOLATION": {
