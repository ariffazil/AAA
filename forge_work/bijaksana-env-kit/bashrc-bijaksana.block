# >>> AAA-BIJAKSANA-ENV v1.2 (2026-10-05 · FI-008 · F13 reversible) >>>
# Additions only — complements the forged cockpit above, duplicates nothing.
# Upgrade: re-run /root/bin/bijaksana-env-install.sh · Rollback: restore the .bak beside this file.
# NOTE: agent tool-shells are NON-interactive and never read this file — this block is for HUMAN sessions.
# The agentic reality surface is the command: reality  → /root/bin/reality-card.sh

# 1. See WHERE you are — root without cwd is blind. Badge preserved; cwd + git appended.
__aaa_git() {
    local b d=""
    b=$(git symbolic-ref --short HEAD 2>/dev/null) || return 0
    GIT_OPTIONAL_LOCKS=0 git status --porcelain 2>/dev/null | head -1 | grep -q . && d="*"
    printf ' (%s%s)' "$b" "$d"
}
if [[ "$PS1" == *'$ ' ]]; then
    PS1="${PS1%???}"'\[\e[33m\]\w\[\e[0m\]$(__aaa_git)\n\$ '
fi

# 2. Dated history — the lab notebook with timestamps.
export HISTTIMEFORMAT='%F %T  '
export HISTSIZE=50000
export HISTFILESIZE=100000

# 3. Seatbelt: interactive rm confirms once on recursive/multi-file deletes.
# Non-interactive shells (agents/scripts) are unaffected — aliases don't load there.
alias rm='rm -I --preserve-root'

# 4. reality — metabolize tersirat → tersurat on demand. Live output, never trust a copy.
[ -x /root/bin/reality-card.sh ] && alias reality='/root/bin/reality-card.sh'
# <<< AAA-BIJAKSANA-ENV v1 <<<
