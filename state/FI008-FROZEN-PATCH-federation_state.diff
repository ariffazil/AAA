+def probe_pending_for_human():
+    """Ask the single owner (arifosmcp.report_lane) for pending human decisions.
+
+    Fail-closed: returns None (= UNKNOWN) when the owner cannot be reached.
+    Never returns 0 as a substitute for "unreadable" (P0 invariant:
+    unmeasured is never a pass, and unreadable is never an empty inbox).
+    """
+    rl = None
+    try:
+        from arifosmcp.runtime import report_lane as rl  # type: ignore
+    except Exception:
+        try:
+            import glob
+            import sys as _sys
+
+            for sp in glob.glob("/opt/arifos/current/venv/lib/python*/site-packages"):
+                if sp not in _sys.path:
+                    _sys.path.append(sp)
+            from arifosmcp.runtime import report_lane as rl  # type: ignore
+        except Exception:
+            return None
+    try:
+        return int(rl.stats().get("pending_for_human"))
+    except Exception:
+        return None
+
+
