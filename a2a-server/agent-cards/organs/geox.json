        "geoscience",
        "earth-intelligence"
      ]
    },
    {
      "id": "geox_contrast_metabolize",
      "name": "geox_contrast_metabolize",
      "description": "Unified anomalous contrast metabolic pipeline. Binds three stages into one call: ISOLATE (deterministic acoustic impedance contrast detection) then MEASURE (AVO gradient + LMR estimates) then CLASSIFY (>=3 stratigraphic trap hypotheses). substrate_class=INERT. Local max QUALIFIED_CANDIDATE - arifOS seals.",
